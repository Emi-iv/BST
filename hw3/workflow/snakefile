configfile: "config/config.yaml"

SAMPLES = config["samples"]
RAW = config["raw_dir"]

rule all:
    input:
        expand("results/fastqc/raw/{sample}_{read}_fastqc.html",
               sample=SAMPLES, read=[1, 2]),
        expand("results/fastqc/trimmed/{sample}_{read}_val_{read}_fastqc.html",
               sample=SAMPLES, read=[1, 2]),
        "results/featurecounts/counts.txt",
        expand("results/kallisto/{sample}/abundance.tsv", sample=SAMPLES),
        expand("results/rseqc/{sample}.bam_stat.txt", sample=SAMPLES),
        expand("results/rseqc/{sample}.infer_experiment.txt", sample=SAMPLES),
        expand("results/rseqc/{sample}.read_distribution.txt", sample=SAMPLES),
        expand("results/rseqc/{sample}.geneBodyCoverage.txt", sample=SAMPLES),
        expand("results/rseqc/{sample}.inner_distance_freq.txt", sample=SAMPLES),
        "results/multiqc/multiqc_report.html",
        "results/featurecounts/counts.txt"
rule fastqc_raw:
    input:
        RAW + "/{sample}_{read}.fastq.gz"
    output:
        html="results/fastqc/raw/{sample}_{read}_fastqc.html",
        zip="results/fastqc/raw/{sample}_{read}_fastqc.zip"

    log:
        "logs/fastqc_raw/{sample}_{read}.log"
    
    threads: 2
    resources:
        mem_mb=2000
    conda:
        "envs/fastqc.yaml"

    shell:
        "fastqc -t {threads} -o results/fastqc/raw {input} > {log} 2>&1"

rule trim:
    input:
        r1=RAW + "/{sample}_1.fastq.gz",
        r2=RAW + "/{sample}_2.fastq.gz"

    output:
        r1="results/trimmed/{sample}_1_val_1.fq.gz",
        r2="results/trimmed/{sample}_2_val_2.fq.gz"
    log:
        "logs/trim/{sample}.log"

    params:
        q=config["trim_quality"],
        length=config["trim_min_length"]

    threads: 4
    resources:
        mem_mb=4000
    conda:
        "envs/trimgalore.yaml"
    shell:
        "trim_galore --paired --quality {params.q} --length {params.length} "
        "--cores {threads} -o results/trimmed {input.r1} {input.r2} > {log} 2>&1"
 
rule fastqc_trimmed:
    input:
        "results/trimmed/{sample}_{read}_val_{read}.fq.gz"
    output:
        html="results/fastqc/trimmed/{sample}_{read}_val_{read}_fastqc.html",
        zip="results/fastqc/trimmed/{sample}_{read}_val_{read}_fastqc.zip"
    log:
        "logs/fastqc_trimmed/{sample}_{read}.log"
    threads: 2
    resources:
        mem_mb=2000
    conda:
        "envs/fastqc.yaml"
    shell:
        "fastqc -t {threads} -o results/fastqc/trimmed {input} > {log} 2>&1"


HISAT2_INDEX = config["hisat2_index"]

#HISAT2_INDEX kuriames tik jei jo dar nėra
rule hisat2_index:
    input:
        config["genome"]
    output:
        expand(HISAT2_INDEX + ".{i}.ht2", i=range(1, 9))
    
    log:
        "logs/hisat2_index/hisat2_index.log"

    threads: 8
    resources:
        mem_mb = 32000,
        runtime=240

    conda:
        "envs/hisat2.yaml"
    
    shell:
        "mkdir -p $(dirname {HISAT2_INDEX}) && "
        "hisat2-build -p {threads} {input} {HISAT2_INDEX} > {log} 2>&1"

#Sulyginimas su genomu ir surūšiuotas BAM
rule hisat2_align:
    input:
        r1="results/trimmed/{sample}_1_val_1.fq.gz",
        r2="results/trimmed/{sample}_2_val_2.fq.gz",
        index=rules.hisat2_index.output
    output:
        bam="results/mapped/{sample}.bam",
        bai="results/mapped/{sample}.bam.bai"
    log:
        "logs/hisat2_align/{sample}.log"

    threads: 8
    resources:
        mem_mb=16000,
        runtime=120
    conda:
        "envs/hisat2.yaml"
    shell:
        "hisat2 -p {threads} -x {HISAT2_INDEX} -1 {input.r1} -2 {input.r2} 2> {log} "
        "| samtools sort -@ {threads} -o {output.bam} - && "
        "samtools index {output.bam}"

#Genų raiška (viena lentelė visiems mėginiams)
rule featurecounts:
    input:
        bams=expand("results/mapped/{sample}.bam", sample=SAMPLES),
        gtf=config["gtf"]
    output:
        counts="results/featurecounts/counts.txt",
        summary="results/featurecounts/counts.txt.summary"
    log:
        "logs/featurecounts/featurecounts.log"
    threads: 4
    resources:
        mem_mb=8000,
        runtime=60
    conda:
        "envs/subread.yaml"
    shell:
        "featureCounts -T {threads} -p --countReadPairs -a {input.gtf} "
        "-o {output.counts} {input.bams} > {log} 2>&1"

rule kallisto_index:
    input:
        config["transcriptome"]
    output:
        config["kallisto_index"]
    log:
        "logs/kallisto_index/kallisto_index.log"

    threads: 8
    resources:
        mem_mb=32000,
        runtime=120

    conda:
        "envs/kallisto.yaml"
    shell:
        "kallisto index -t {threads} -i {output} {input} > {log} 2>&1"

#Transkripto raiška (Įvertinimas kiekvienam mėginiui)
rule kallisto_quant:
    input:
        r1="results/trimmed/{sample}_1_val_1.fq.gz",
        r2="results/trimmed/{sample}_2_val_2.fq.gz",
        index=config["kallisto_index"]
    output:
        "results/kallisto/{sample}/abundance.tsv"
    log:
        "logs/kallisto_quant/{sample}.log"
    threads: 4
    resources:
        mem_mb=8000,
        runtime=60
    conda:
        "envs/kallisto.yaml"
    shell:
        "kallisto quant -t {threads} -i {input.index} "
        "-o results/kallisto/{wildcards.sample} "
        "{input.r1} {input.r2} > {log} 2>&1"

rule gtf_to_bed:
    input:
        config["gtf"]
    output:
        config["bed"]

    log:
        "logs/gtf_to_bed/gtf_to_bed.log"
    threads: 1
    resources:
        mem_mb=8000,
        runtime=60

    conda:
        "envs/ucsc.yaml"

    shell:
        "gtfToGenePred -genePredExt -ignoreGroupsWithoutExons {input} {output}.genepred 2> {log} && "
        "genePredToBed {output}.genepred {output} 2>> {log} && "
        "rm {output}.genepred"

#Sulyginimo statistika

