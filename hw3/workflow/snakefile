#Skaitinių genomo languose visimes mėginiams bendra marica
rule deeptools_multibamsummary:
    input:
        bams=expand("results/mapped/{sample}.bam", sample=SAMPLES),
        bais=expand("results/mapped/{sample}.bam.bai", sample=SAMPLES)
    output:
        "results/deeptools/multiBamSummary.npz"
    log:
        "logs/deeptools/multiBamSummary.log"
    threads: 4
    resources:
        mem_mb=8000,
        runtime=120
    conda:
        "envs/deeptools.yaml"
    shell:
        "multiBamSummary bins --bamfiles {input.bams} --smartLabels "
        "-p {threads} -o {output} > {log} 2>&1"

#Mėginių korealeacija heatmap!!
rule deeptools_correlation:
    input:
        "results/deeptools/multiBamSummary.npz"
    output:
        png="results/deeptools/correlation_heatmap.png",
        tab="results/deeptools/correlation_matrix.tab"
    log:
        "logs/deeptools/plotCorrelation.log"
    resources:
        mem_mb=4000,
        runtime=30
    conda:
        "envs/deeptools.yaml"
    shell:
        "plotCorrelation -in {input} --corMethod spearman --skipZeros "
        "--whatToPlot heatmap --plotNumbers "
        "-o {output.png} --outFileCorMatrix {output.tab} > {log} 2>&1 && "
        "sed -i '1i #plotCorrelation --outFileCorMatrix' {output.tab}"
#PCA
rule deeptools_pca:
    input:
        "results/deeptools/multiBamSummary.npz"
    output:
        png="results/deeptools/pca.png",
        tab="results/deeptools/pca.tab"
    log:
        "logs/deeptools/plotPCA.log"
    resources:
        mem_mb=4000,
        runtime=30
    conda:
        "envs/deeptools.yaml"
    shell:
        "plotPCA -in {input} -o {output.png} --outFileNameData {output.tab} > {log} 2>&1 && "
        "sed -i '1i #plotPCA --outFileNameData' {output.tab}"
rule multiqc:
    input:
        expand("results/fastqc/raw/{sample}_{read}_fastqc.zip", sample=SAMPLES, read=[1, 2]),
        expand("results/fastqc/trimmed/{sample}_{read}_val_{read}_fastqc.zip", sample=SAMPLES, read=[1, 2]),
        expand("results/mapped/{sample}.bam", sample=SAMPLES),
        "results/featurecounts/counts.txt.summary",
        expand("results/kallisto/{sample}/abundance.tsv", sample=SAMPLES),
        expand("results/rseqc/{sample}.bam_stat.txt", sample=SAMPLES),
        expand("results/rseqc/{sample}.infer_experiment.txt", sample=SAMPLES),
        expand("results/rseqc/{sample}.read_distribution.txt", sample=SAMPLES),
        expand("results/rseqc/{sample}.geneBodyCoverage.txt", sample=SAMPLES),
        expand("results/rseqc/{sample}.inner_distance_freq.txt", sample=SAMPLES),
        "results/deeptools/correlation_matrix.tab",
        "results/deeptools/pca.tab"
    output:
        "results/multiqc/multiqc_report.html"
    log:
        "logs/multiqc/multiqc.log"
    resources:
        mem_mb=4000,
        runtime=30
    conda:
        "envs/multiqc.yaml"
    shell:
        "multiqc results logs -o results/multiqc -f > {log} 2>&1"

rule genebody_bed:
    input:
        config["gtf"]
    output:
        config["genebody_bed"]
    log:
        "logs/gtf_to_bed/genebody_bed.log"
    resources:
        mem_mb=8000,
        runtime=60
    conda:
        "envs/ucsc.yaml"
    shell:
        "grep 'Ensembl_canonical' {input} | grep 'transcript_type \"protein_coding\"' > {output}.gtf && "
        "gtfToGenePred -genePredExt {output}.gtf {output}.genepred 2> {log} && "
        "genePredToBed {output}.genepred {output} 2>> {log} && "
        "rm {output}.gtf {output}.genepred"