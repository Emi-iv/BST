    resources:
        mem_mb=4000,
        runtime=60
    conda:
        "envs/rseqc.yaml"
    shell:
        "bam_stat.py -i {input} > {output} 2> {log}"

#Strandness (kuri DNR granddinė buvo sekvenuota)
